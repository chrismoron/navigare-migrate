<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Form view                                                     -->
    <!-- ============================================================ -->
    <record id="view_migrate_schedule_form" model="ir.ui.view">
        <field name="name">migrate.schedule.form</field>
        <field name="model">migrate.schedule</field>
        <field name="arch" type="xml">
            <form string="Scheduled Migration">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="cron_id"
                            groups="group_migrate_manager"/>
                    <button name="action_deactivate" type="object"
                            string="Deactivate" class="btn-secondary"
                            invisible="not cron_id"
                            groups="group_migrate_manager"/>
                    <button name="action_run_now" type="object"
                            string="Run Now" class="btn-warning"
                            groups="group_migrate_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Schedule Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="profile_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Scheduling">
                            <label for="interval_number"/>
                            <div class="o_row">
                                <field name="interval_number" class="oe_inline"/>
                                <field name="interval_type" class="oe_inline"/>
                            </div>
                            <field name="next_run"/>
                            <field name="last_run"/>
                            <field name="last_state"/>
                        </group>
                    </group>
                    <group>
                        <group string="Source">
                            <field name="source_type"/>
                            <field name="source_path"
                                   invisible="source_type not in ('file_path', 'url', 'sftp')"/>
                            <field name="source_attachment"
                                   filename="source_attachment_name"
                                   invisible="source_type != 'attachment'"/>
                            <field name="source_attachment_name" invisible="1"/>
                        </group>
                        <group string="Export Destination">
                            <field name="export_path"/>
                            <field name="export_email"/>
                        </group>
                    </group>
                    <group string="Error Handling">
                        <group>
                            <field name="max_retries"/>
                        </group>
                        <group>
                            <field name="notify_on_error"/>
                            <field name="notify_user_ids" widget="many2many_tags"
                                   invisible="not notify_on_error"/>
                        </group>
                    </group>
                    <field name="cron_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- List view                                                     -->
    <!-- ============================================================ -->
    <record id="view_migrate_schedule_list" model="ir.ui.view">
        <field name="name">migrate.schedule.list</field>
        <field name="model">migrate.schedule</field>
        <field name="arch" type="xml">
            <list string="Scheduled Migrations">
                <field name="name"/>
                <field name="profile_id"/>
                <field name="source_type"/>
                <field name="interval_number" string="Every"/>
                <field name="interval_type"/>
                <field name="next_run"/>
                <field name="last_run"/>
                <field name="last_state" widget="badge"
                       decoration-success="last_state == 'done'"
                       decoration-danger="last_state == 'error'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

</odoo>
