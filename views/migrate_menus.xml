<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Root menu                                                     -->
    <!-- ============================================================ -->
    <menuitem
        id="menu_navigare_migrate_root"
        name="Navigare Migrate"
        web_icon="navigare_migrate,static/description/icon.png"
        groups="group_migrate_user"
        sequence="90"
    />

    <!-- ============================================================ -->
    <!-- Top-level actions                                             -->
    <!-- ============================================================ -->

    <!-- Dashboard -->
    <menuitem
        id="menu_migrate_dashboard"
        name="Dashboard"
        parent="menu_navigare_migrate_root"
        action="action_migrate_dashboard"
        sequence="10"
    />

    <!-- Profiles -->
    <record id="action_migrate_profile" model="ir.actions.act_window">
        <field name="name">Profiles</field>
        <field name="res_model">migrate.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a migration profile
            </p>
            <p>Define file format, field mappings, and import/export behaviour.</p>
        </field>
    </record>

    <menuitem
        id="menu_migrate_profiles"
        name="Profiles"
        parent="menu_navigare_migrate_root"
        action="action_migrate_profile"
        sequence="20"
    />

    <!-- Operations -->
    <record id="action_migrate_operation" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">migrate.operation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No migration operations yet
            </p>
            <p>Operations are created automatically when you run an import or export.</p>
        </field>
    </record>

    <menuitem
        id="menu_migrate_operations"
        name="Operations"
        parent="menu_navigare_migrate_root"
        action="action_migrate_operation"
        sequence="30"
    />

    <!-- Schedules -->
    <record id="action_migrate_schedule" model="ir.actions.act_window">
        <field name="name">Schedules</field>
        <field name="res_model">migrate.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up a scheduled migration
            </p>
            <p>Automate recurring imports or exports via cron jobs.</p>
        </field>
    </record>

    <menuitem
        id="menu_migrate_schedules"
        name="Schedules"
        parent="menu_navigare_migrate_root"
        action="action_migrate_schedule"
        groups="group_migrate_manager"
        sequence="40"
    />

    <!-- Templates -->
    <record id="action_migrate_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">migrate.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a migration template
            </p>
            <p>Pre-built configurations you can use to quickly set up profiles.</p>
        </field>
    </record>

    <menuitem
        id="menu_migrate_templates"
        name="Templates"
        parent="menu_navigare_migrate_root"
        action="action_migrate_template"
        sequence="50"
    />

    <!-- ============================================================ -->
    <!-- Configuration sub-menu                                        -->
    <!-- ============================================================ -->
    <menuitem
        id="menu_migrate_config"
        name="Configuration"
        parent="menu_navigare_migrate_root"
        groups="group_migrate_manager"
        sequence="100"
    />

    <!-- Value Maps -->
    <record id="action_migrate_value_map" model="ir.actions.act_window">
        <field name="name">Value Maps</field>
        <field name="res_model">migrate.value.map</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a value map
            </p>
            <p>Define source-to-target value translations for field transformations.</p>
        </field>
    </record>

    <menuitem
        id="menu_migrate_value_maps"
        name="Value Maps"
        parent="menu_migrate_config"
        action="action_migrate_value_map"
        sequence="10"
    />

    <!-- Dependencies -->
    <record id="action_migrate_dependency" model="ir.actions.act_window">
        <field name="name">Dependencies</field>
        <field name="res_model">migrate.dependency</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define model dependencies
            </p>
            <p>Specify the import order between models to satisfy relational constraints.</p>
        </field>
    </record>

    <menuitem
        id="menu_migrate_dependencies"
        name="Dependencies"
        parent="menu_migrate_config"
        action="action_migrate_dependency"
        sequence="20"
    />

</odoo>
