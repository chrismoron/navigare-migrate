<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_migrate_export_wizard_form" model="ir.ui.view">
        <field name="name">migrate.export.wizard.form</field>
        <field name="model">migrate.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Data">
                <field name="state" invisible="1"/>

                <!-- ===== CONFIG state ===== -->
                <group invisible="state != 'config'">
                    <group string="Profile">
                        <field name="profile_id"/>
                        <field name="model_id"/>
                        <field name="format_type"/>
                    </group>
                    <group string="Filters">
                        <field name="domain_text"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="limit"/>
                    </group>
                </group>
                <footer invisible="state != 'config'">
                    <button name="action_export" type="object"
                            string="Export"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>

                <!-- ===== DONE state ===== -->
                <group invisible="state != 'done'">
                    <group string="Result">
                        <field name="record_count"/>
                        <field name="result_file" filename="result_filename"/>
                        <field name="result_filename" invisible="1"/>
                        <field name="operation_id"/>
                    </group>
                </group>
                <footer invisible="state != 'done'">
                    <button name="action_open_operation" type="object"
                            string="Open Operation"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Data</field>
        <field name="res_model">migrate.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
